# Copy to .env (never commit .env). All values optional for the deterministic baseline.
# The deterministic E0 pipeline runs fully with every value below EMPTY.
# Placeholders only - never put real credentials in this file.
MODEL_PROVIDER=
MODEL_NAME=
API_KEY=
VISION_MODEL_NAME=
# --- Optional LLM/vision enhancement (strictly gated; deterministic fallback always applies) ---
# Set LLM_ENABLED=1 only when credentials + network are available. Empty/disabled = deterministic E0.
LLM_ENABLED=
LLM_TIMEOUT_S=
LLM_MAX_RETRIES=
LLM_MIN_CONFIDENCE=
VISION_MODEL_TIMEOUT_S=
# --- Runtime knobs (safe defaults live in code; env only overrides) ---
LOG_LEVEL=
